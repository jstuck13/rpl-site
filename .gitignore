# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Profile sources — internal working notes, not for the repo.
# These contain open questions and season logs written for Jacob, and are
# stripped by `npm run profiles` before anything is published.
data/raw/profiles/
data/raw/*-draft.md
data/raw/*.zip

# Recap sources — drafted from the same project docs, so they get the same
# treatment: gitignored in, stripped by `npm run recaps`, committed only as
# src/data/recaps.json.
data/raw/recaps/

# Inbox for handoff drops from Cowork sessions. They carry copies of the recap
# markdown, so they stay out of the repo for the same reason data/raw does.
handoff/
